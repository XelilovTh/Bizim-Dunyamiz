# 1. Cloudinary - Images
VITE_CL_NAME=your_cloudinary_name
VITE_CL_PRESET=your_preset
VITE_CL_KEY=your_key
CL_NAME=your_cloudinary_name
CL_KEY=your_key
CL_SECRET=your_secret

# 2. Cloudinary - Audio Tracks
VITE_CL_MUSIC_NAME=your_music_cloud_name
VITE_CL_MUSIC_PRESET=your_music_preset
VITE_CL_MUSIC_KEY=your_music_key
CL_MUSIC_NAME=your_music_cloud_name
CL_MUSIC_KEY=your_music_key
CL_MUSIC_SECRET=your_music_secret

# 3. GitHub Database
GH_TOKEN=your_github_personal_access_token
GH_OWNER=XelilovTh
GH_REPO=Dunyam
VITE_GH_OWNER=XelilovTh
VITE_GH_REPO=Dunyam

# 4. Telegram Bots
NOTIF_BOT_TOKEN=your_notif_bot_token
TG_TOKEN=your_media_upload_bot_token
ADMIN_CHAT_ID=your_chat_id

# 5. Site Password
SITE_PASSWORD=0102
VITE_SITE_PASSWORD=0102
